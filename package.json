{
  "name": "dsh-chat-switch",
  "version": "0.2.1",
  "description": "Chat ⇄ Harness switch in the DSH sidebar with a chat.deepseek.com bridge (verified on HarmonyOS phones running DSHM; Windows and other platforms untested)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "chat",
    "sidebar",
    "chat.deepseek.com"
  ],
  "license": "MIT",
  "author": "Muhan-Q",
  "icon": "./icon.svg",
  "homepage": "https://github.com/Muhan-Q/dsh-chat-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhan-Q/dsh-chat-switch.git"
  },
  "bugs": {
    "url": "https://github.com/Muhan-Q/dsh-chat-switch/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "assets",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/notes-chat-api.md",
    "docs/screenshots"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "verifiedOn": [
    "Huawei HarmonyOS phone · DSHM (DeepSeek Harness on-device, host 0.2.2-rc.5+dshm.1, ArkWeb WebView)"
  ],
  "unverifiedOn": [
    "Windows DSH",
    "macOS / Linux desktop DSH",
    "Android phone DSH",
    "iOS phone DSH"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
